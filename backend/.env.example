# ---- App ----
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./clinixai.db

# ---- LLM Provider ----
# Choose ONE: "gemini" or "groq"
# Switching providers = change LLM_PROVIDER + the matching API key. No code changes needed.
LLM_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-flash

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Comma-separated list of allowed CORS origins for your deployed frontend
# (e.g. https://clinixai.com). Leave empty to allow only localhost dev origins.
FRONTEND_ORIGINS=
